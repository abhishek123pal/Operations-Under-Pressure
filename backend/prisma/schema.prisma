datasource db {
  provider = "postgresql"
 
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  memberships     Membership[]
  assignedItems   WorkItem[]       @relation("AssignedItems")
  createdItems    WorkItem[]       @relation("CreatedItems")
  activities      ActivityEvent[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships Membership[]
  workItems   WorkItem[]

  @@map("teams")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  teamId    String   @map("team_id")
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
  @@map("memberships")
}

model WorkItem {
  id          String        @id @default(uuid())
  title       String
  description String?
  type        WorkItemType  @default(TASK)
  priority    Priority      @default(MEDIUM)
  status      Status        @default(OPEN)
  version     Int           @default(1)
  
  teamId      String        @map("team_id")
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  assigneeId  String?       @map("assignee_id")
  assignee    User?         @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId   String        @map("creator_id")
  creator     User          @relation("CreatedItems", fields: [creatorId], references: [id], onDelete: Restrict)

  dueDate     DateTime?     @map("due_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  activities  ActivityEvent[]

  @@index([teamId, status, priority])
  @@index([assigneeId])
  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("work_items")
}

model ActivityEvent {
  id         String   @id @default(uuid())
  workItemId String   @map("work_item_id")
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  type       String
  metadata   Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([workItemId, createdAt(sort: Desc)])
  @@map("activity_events")
}

model IdempotencyKey {
  key            String   @id
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxJob {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_jobs")
}